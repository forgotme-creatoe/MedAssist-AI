rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Primitive Definition
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    // Validation Blueprint for User
    function isValidUser(data) {
      return data.keys().size() >= 3 && data.keys().size() <= 5
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 200))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && ('createdAt' in data && data.createdAt is timestamp)
        && ('updatedAt' in data && data.updatedAt is timestamp);
    }
    
    // User profile creation strict key check
    function isValidUserCreate(data) {
      return data.keys().hasAll(['email', 'createdAt', 'updatedAt']) 
        && data.keys().size() <= 5
        && data.email is string && data.email.size() <= 200
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 200))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    // Match path
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId; // PII Isolation (email)
      
      allow create: if isSignedIn() 
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserCreate(incoming());

      allow update: if isSignedIn() 
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUser(incoming())
        && incoming().createdAt == existing().createdAt // Immortal Field
        && incoming().updatedAt == request.time // Temporal Integrity
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
        );

      allow delete: if false; // Users shouldn't be deleted directly here
    }
  }
}
